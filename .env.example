# Copy this file to .env and fill in your own values. Never upload .env to GitHub.

# From MongoDB Atlas: Connect > Drivers. Put /portal before the "?".
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/portal?retryWrites=true&w=majority

# Any long random text. It signs the login cookies.
JWT_SECRET=write-a-long-random-sentence-here

# Any long random text. GitHub Actions uses it to trigger deadline reminders.
CRON_SECRET=write-another-long-random-sentence-here
